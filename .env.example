# ============================================================================
# Layer 06 - LLM Gateway. Three providers, routed per task.
# ============================================================================

# Answer path (guest-facing prose). Cheap, high volume.
OPENAI_API_KEY=
ANSWER_MODEL=gpt-4o-mini

# Groundedness verifier + query rewrite + rerank + eval.
# The verifier is a blocking check, so it stays on a stronger model.
ANTHROPIC_API_KEY=
VERIFIER_MODEL=claude-haiku-4-5
REWRITE_MODEL=claude-haiku-4-5
RERANK_MODEL=claude-sonnet-5
EVAL_MODEL=claude-sonnet-5

# Embeddings. gemini-embedding-2 auto-normalises truncated dimensions,
# so 1536 needs no manual re-normalisation.
# CHANGING EITHER OF THESE INVALIDATES EVERY INDEXED CORPUS.
GOOGLE_API_KEY=
DENSE_MODEL=gemini-embedding-2
DENSE_DIM=1536

# Sparse (lexical BM25) half of hybrid search. Runs locally, no key.
SPARSE_MODEL=Qdrant/bm25

# ============================================================================
# Vector store
# ============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hotel_chunks

# ============================================================================
# Config + drift + eval storage (Layer 09)
# ============================================================================
DATABASE_PATH=data/guide.db

# ============================================================================
# Ingestion. Re-crawls are manual only - triggered per property.
# ============================================================================
CRAWL_MAX_PAGES=300
CRAWL_MAX_DEPTH=4
CRAWL_CONCURRENCY=6
CRAWL_DELAY_SECONDS=0.5
CRAWL_RESPECT_ROBOTS=true
CRAWL_USER_AGENT=hotel-ai-guide/0.1 (+https://example.com/bot)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25

# ============================================================================
# Chunking + retrieval
# ============================================================================
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=80
RETRIEVE_TOP_K=40
RERANK_TOP_N=8
MIN_RERANK_SCORE=4

# ============================================================================
# Serving (Layer 02 / 09)
# ============================================================================
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_BURST=5
DEFAULT_DAILY_SPEND_CAP_USD=5.0
# The admin surface (crawl, upload, corpus delete) refuses to serve while this
# is still the placeholder. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-before-deploying
