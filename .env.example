# ============================================================================
# Layer 06 - LLM Gateway. OpenAI chats, Cohere reranks, Google embeds.
# ============================================================================

# One key serves every chat task below.
OPENAI_API_KEY=

# Answer path (guest-facing prose). Cheap, high volume.
ANSWER_MODEL=gpt-4o-mini

# Query rewrite + page classification. Same cheap tier as answers.
REWRITE_MODEL=gpt-4o-mini

# Groundedness verifier. Blocking - an answer that fails it is never sent.
# Structured extraction against supplied sources, so mini is enough.
VERIFIER_MODEL=gpt-4o-mini

# Offline eval. Judgement calls, so a tier up.
EVAL_MODEL=gpt-4o

# Applies to the answer only. The rewrite, the classifier, the groundedness
# verifier and the eval judge all run at 0: they are judgements, not prose,
# and at the provider default of 1.0 the verifier blocks a different set of
# correct answers on every run.
ANSWER_TEMPERATURE=0.2

# Unused. The Anthropic adapter is still in the gateway, so pointing any model
# above at a claude-* id routes there instead - that needs a key here and the
# optional SDK: pip install -e ".[anthropic]"
# ANTHROPIC_API_KEY=

# Embeddings. gemini-embedding-2 auto-normalises truncated dimensions,
# so 1536 needs no manual re-normalisation.
# CHANGING EITHER OF THESE INVALIDATES EVERY INDEXED CORPUS.
GOOGLE_API_KEY=
DENSE_MODEL=gemini-embedding-2
DENSE_DIM=1536

# Reranking. A dedicated relevance model, not a chat model: no prompt, ~100ms,
# and billed per search unit (one query against up to 100 passages) rather than
# per token. Point RERANK_MODEL at a chat model instead - gpt-4o-mini, say - to
# fall back to the listwise LLM reranker, which needs no Cohere key.
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

# Sparse (lexical BM25) half of hybrid search. Runs locally, no key.
SPARSE_MODEL=Qdrant/bm25

# ============================================================================
# Vector store
# ============================================================================
# An http(s) URL is a Qdrant server; anything else is an embedded store held in
# that directory (or ":memory:") - same client, same hybrid query path, no
# server to run. Embedded is single-process and ignores payload indexes: fine
# for development, not for serving.
QDRANT_URL=http://localhost:6333
# QDRANT_URL=data/qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION=hotel_chunks

# ============================================================================
# Config + indexed-source + eval storage (Layer 09)
# ============================================================================
DATABASE_PATH=data/guide.db

# ============================================================================
# Ingestion. Owner-supplied documents only - nothing is fetched from the web.
# ============================================================================
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25

# ============================================================================
# Chunking + retrieval
# ============================================================================
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=80
RETRIEVE_TOP_K=40
RERANK_TOP_N=8
# Two thresholds because the two rerankers speak different units, and only the
# one matching RERANK_MODEL is read. Below it, nothing is relevant and the
# Guide deflects rather than answering.
MIN_RERANK_SCORE=4        # 0-10 rubric, listwise LLM reranker
MIN_RERANK_RELEVANCE=0.2  # 0-1 relevance, Cohere. Tune against the eval set.

# ============================================================================
# Serving (Layer 02 / 09)
# ============================================================================
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_BURST=5

# Per-property daily cap, charged to one client.
DEFAULT_DAILY_SPEND_CAP_USD=5.0

# Ceilings under every model call - chat, ingestion, eval and embeddings alike.
# Ingestion and evals bill no property, so the cap above never sees them; these
# are what bound a testing session. A call that would cross any of them is
# refused, not queued. 0 = unlimited.
#
# Per process: one `guide eval`, one ingest, one server session. Starts at zero
# every run, so it holds even after the day's ledger is nearly spent.
RUN_SPEND_CAP_USD=0.15
#
# Cumulative across processes, per UTC day, persisted in the database. Keep it
# above the run cap: at the same value, the first run of the day exhausts both.
ACCOUNT_DAILY_SPEND_CAP_USD=0.50
ACCOUNT_DAILY_CALL_CAP=2000
# The admin surface (upload, corpus delete, metrics) refuses to serve while
# this is still the placeholder. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-before-deploying

# ============================================================================
# Logfire (Layer 08). Every step of every run as a nested, timed trace.
# ============================================================================
# Without a token nothing is exported and nothing breaks - spans are still
# created and the terminal still prints. To turn export on:
#   logfire auth
#   logfire projects use --org <org> <project>
# which writes a write token to .logfire/logfire_credentials.json and is
# picked up automatically. Set this only to override that file - a stale
# value here silently shadows the working one.
LOGFIRE_TOKEN=
# Keeps a laptop run out of the same view as production traffic.
LOGFIRE_ENVIRONMENT=dev
# console: one short human line per event. json: the same fields for a shipper.
LOG_FORMAT=console

# Retries inside the provider SDK, on top of the first attempt. Each retry is
# a real billed call, so this bounds what a bad minute can cost as much as it
# bounds latency: at 3, one flapping endpoint quadruples the bill.
PROVIDER_MAX_RETRIES=1
